# Copy to .env (gitignored) for local scripts. Lambda reads these from SSM Parameter Store instead.
OPENAI_API_KEY=
# Required for GitHub source — fine-grained PAT on Joel's account, all personal repos (or All repositories).
# Read-only repository permissions:
#   Metadata: Read
#   Contents: Read
#   Issues: Read
#   Pull requests: Read
#   Actions: Read
# With a token, Orbit auto-discovers all owned personal repos (skips forks/archived) and pulls
# commits, open issues/PRs, recent Actions runs, and push dates for the briefing.
GITHUB_TOKEN=
# Optional override: comma-separated owner/repo list. Leave blank to auto-discover.
# GITHUB_REPOS=
# Optional; usually unnecessary — /user/repos uses the token's identity.
# GITHUB_USER=
BRIEFING_EMAIL=anarbajoel@gmail.com
# One-time local OAuth setup inputs. Create a Google "Desktop app" OAuth client,
# fill these two values, then run `npm run setup:google`. The script stores the
# resulting refresh token in SSM and never prints it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional alternatives for local source testing only; do not commit real values.
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_OAUTH_JSON=
TASKS_TABLE=orbit-tasks
REPORTS_BUCKET=
